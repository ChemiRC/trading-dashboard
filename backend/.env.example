# ==============================================================
#  BACKEND — plantilla de variables de entorno
#
#  Copia este archivo a `backend/.env` y rellena los valores.
#  `.env` está en .gitignore: nunca debe llegar al repositorio.
#
#  Todo lo que hay aquí es SECRETO y vive solo en el servidor.
#  El frontend jamás lee estas variables.
# ==============================================================

# --- Base de datos: PostgreSQL en Supabase --------------------
# Supabase → Project Settings → Database → Connection string
#
# Copia la cadena TAL CUAL del panel. Los proyectos nuevos no tienen host de
# conexion directa (db.<ref>.supabase.co ya no existe): todo va por el pooler,
# cuyo host es aws-N-<region>.pooler.supabase.com y cuyo usuario es
# `postgres.<ref>`, no `postgres`.
#
#   Session pooler     (5432)  → migraciones y scripts DDL
#   Transaction pooler (6543)  → la app en marcha
#
# Si la contrasena lleva caracteres especiales, hay que escaparlos en la URL:
#   @ -> %40      # -> %23      / -> %2F      : -> %3A
# Sin escapar, libpq parsea mal la cadena y falla con errores enganosos.
DATABASE_URL=

# --- API de Supabase ------------------------------------------
# SUPABASE_URL es público, pero lo mantenemos aquí por coherencia.
# SERVICE_ROLE_KEY ignora las políticas RLS: es una llave maestra.
# Si esta llave llega al navegador, cualquiera puede leer y borrar
# toda la base de datos. Solo backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicación ------------------------------------------------
APP_ENV=development
LOG_LEVEL=info

# Orígenes autorizados para CORS, separados por coma.
# 5173 es el puerto por defecto del servidor de desarrollo de Vite.
# Nunca "*": el backend es el único que tiene credenciales.
CORS_ORIGINS=http://localhost:5173

# --- Autenticacion ---------------------------------------------------------
# Contrasena compartida (dos personas de confianza, un solo nivel de acceso)
# y secreto con el que se firman los tokens de sesion.
#
# Ninguna de las dos tiene valor por defecto, y es deliberado: si faltan, TODO
# /api/* responde 503 en vez de quedarse abierto. Un olvido en el despliegue
# deja la aplicacion inaccesible, nunca publica.
#
# El secreto NO se inventa a mano. Generalo con:
#     openssl rand -hex 32
# Cambiarlo invalida todas las sesiones abiertas, que es justo lo que quieres
# si sospechas que alguien se ha llevado un token.
APP_PASSWORD=
APP_TOKEN_SECRET=

# REGLA B — contradiccion entre el disparador y el balance.
# CONFIRMADA por el trader y activa. Sigue como variable de entorno, y no
# cableada en el codigo, porque apagarla es la unica forma de medir cuanto
# filtra: se pone en false y ni el motor ni el esquema SQL cambian.
RULE_B_ENABLED=true

# Pool de conexiones. Un dashboard de un solo usuario no necesita mas.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4

# ==============================================================
#  FASE 2 — Bybit (importar historial de operaciones cerradas)
#
#  La API key DEBE ser de solo lectura:
#    - sin permiso de trading
#    - sin permiso de retiro (withdrawal)
#    - con IP restringida si es posible
#
#  No es una precaucion temporal: este backend solo llama a
#  endpoints GET de consulta y nunca ejecutara una orden.
#
#  Sin estas dos, POST /api/trades/sync responde 503 y no
#  intenta nada -- el mismo fallo cerrado que la autenticacion.
# ==============================================================
BYBIT_API_KEY=
BYBIT_API_SECRET=

# true  -> api-testnet.bybit.com   (cuenta de pruebas)
# false -> api.bybit.com           (cuenta real)
#
# El valor seguro es el que sale por defecto: olvidarse de esta
# variable apunta a testnet, nunca a la cuenta real.
BYBIT_TESTNET=true
