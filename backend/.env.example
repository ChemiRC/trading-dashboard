# ==============================================================
#  BACKEND — plantilla de variables de entorno
#
#  Copia este archivo a `backend/.env` y rellena los valores.
#  `.env` está en .gitignore: nunca debe llegar al repositorio.
#
#  Todo lo que hay aquí es SECRETO y vive solo en el servidor.
#  El frontend jamás lee estas variables.
# ==============================================================

# --- Base de datos: PostgreSQL en Supabase --------------------
# Supabase → Project Settings → Database → Connection string (URI)
# Usa el puerto del pooler (6543) para conexiones desde la app.
DATABASE_URL=

# --- API de Supabase ------------------------------------------
# SUPABASE_URL es público, pero lo mantenemos aquí por coherencia.
# SERVICE_ROLE_KEY ignora las políticas RLS: es una llave maestra.
# Si esta llave llega al navegador, cualquiera puede leer y borrar
# toda la base de datos. Solo backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicación ------------------------------------------------
APP_ENV=development
LOG_LEVEL=info

# Orígenes autorizados para CORS, separados por coma.
# 5173 es el puerto por defecto del servidor de desarrollo de Vite.
CORS_ORIGINS=http://localhost:5173

# ==============================================================
#  FASE 2 — Bybit (todavía sin usar, se deja documentado)
#
#  La API key DEBE ser de solo lectura:
#    - sin permiso de trading
#    - sin permiso de retiro (withdrawal)
#    - con IP restringida si es posible
# ==============================================================
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true
