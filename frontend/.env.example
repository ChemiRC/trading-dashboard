# ==============================================================
#  FRONTEND — plantilla de variables de entorno
#
#  Copia este archivo a `frontend/.env` y rellena los valores.
#
#  ATENCIÓN: Vite inyecta las variables con prefijo VITE_ dentro
#  del bundle de JavaScript que se descarga el navegador.
#  Es decir: TODO lo que escribas aquí es PÚBLICO y legible por
#  cualquiera que abra las DevTools.
#
#  Por eso este archivo no contiene ni puede contener credenciales.
#  Las llaves de Supabase y del exchange viven solo en backend/.env.
# ==============================================================

# URL base del backend FastAPI.
# Desarrollo: http://localhost:8000
# Producción: la URL pública que dé Railway.
VITE_API_BASE_URL=http://localhost:8000
